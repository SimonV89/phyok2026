# =========================
# PhyOK Root Runtime Config
# =========================
# 复制为根目录 env2 后再填写真实值：
# cp env2.example env2

# -------------------------
# Base
# -------------------------
COMPOSE_PROJECT_NAME=phyok
PUBLIC_HOST=www.phyok.com
APP_BASE_URL=http://127.0.0.1:3002
CLIENT_BASE_URL=http://127.0.0.1:3001
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3002

# -------------------------
# CMS Admin
# -------------------------
CMS_ADMIN_USERNAME=
CMS_ADMIN_PASSWORD=
CMS_AUTH_SECRET=

# -------------------------
# Service Ports
# -------------------------
CHAT_WEB_PORT=3001
NODE2_PORT=3002
AUTH_PORT=18081
TENANT_PORT=18082
MEMORY_PORT=18083
KNOWLEDGE_PORT=18084
BILLING_PORT=18085
PAYMENT_PORT=18086
AUDIT_PORT=18087
PRIVACY_PORT=18088
OPS_ADMIN_PORT=18089

# -------------------------
# PostgreSQL
# -------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=phyok
POSTGRES_USER=phyok
POSTGRES_PASSWORD=change_me_pg

# -------------------------
# Redis / Kafka / Qdrant
# -------------------------
REDIS_PASSWORD=change_me_redis
QDRANT_API_KEY=change_me_qdrant
QDRANT_COLLECTION=phyok_memory_fragments
KAFKA_NODE_ID=1
KAFKA_CLUSTER_ID=abcdefghijklmnopqrstuv
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093

# -------------------------
# Node2 / BFF / Agent
# -------------------------
PORT=3002
CHAT_HISTORY_STORE_FILE=./phyok-node2/data/chat-v2-history.json
CHAT_HISTORY_RETENTION_DAYS=90
DOMAIN_CLIENT_MODE=http
LOCAL_DEBUG_ALLOW_DEGRADED=true
MEMORY_TRANSPORT=http

JAVA_DOMAIN_BASE_URL=http://memory-service:18083
JAVA_AUTH_BASE_URL=http://auth-service:18081
JAVA_BILLING_BASE_URL=http://billing-service:18085
JAVA_PAYMENT_BASE_URL=http://payment-service:18086
JAVA_AUDIT_BASE_URL=http://audit-service:18087

# -------------------------
# AI / SiliconFlow
# -------------------------
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Pro
SILICONFLOW_INGEST_MODEL=deepseek-ai/DeepSeek-V4-Pro
SILICONFLOW_CONCLUDE_MODEL=deepseek-ai/DeepSeek-V4-Pro
SILICONFLOW_SKILLS_MODEL=deepseek-ai/DeepSeek-V4-Pro
SILICONFLOW_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_VISION_FAST_MODEL=Qwen/Qwen3-VL-8B-Instruct
SILICONFLOW_VISION_FALLBACK_MODEL=Qwen/Qwen3-VL-32B-Instruct
SILICONFLOW_VISION_TIMEOUT_MS=45000

# -------------------------
# Auth Service
# -------------------------
PHYOK_AUTH_DEFAULT_TENANT_ID=tenant-demo
PHYOK_AUTH_DEFAULT_APP_ID=phyok-chat-web
AUTH_EMAIL_CODE_TTL_SECONDS=600
AUTH_EMAIL_SEND_COOLDOWN_SECONDS=60
AUTH_SESSION_TTL_DAYS=30
AUTH_INTERNAL_BASE_URL=http://auth-service:18081
AUTH_DEBUG_RETURN_CODE=false
ENABLE_DEV_SEED_LOGIN=false
AUTH_SEED_EMAIL_PATTERN=
AUTH_SEED_EMAIL_CODE=
AUTH_LOCAL_DEBUG_CODE=
LOCAL_DEBUG_IDENTITY_EMAIL=

TENCENT_SES_SECRET_ID=
TENCENT_SES_SECRET_KEY=
TENCENT_SES_FROM_EMAIL=
TENCENT_SES_TEMPLATE_EN=
TENCENT_SES_TEMPLATE_ZH=
TENCENT_SES_REGION=ap-hongkong
TENCENT_SES_API_ENDPOINT=ses.ap-hongkong.tencentcloudapi.com

# -------------------------
# Memory / Knowledge / Privacy
# -------------------------
MEMORY_GATE_REQUIRED_COUNT=5
MEMORY_PREVIEW_TOP_K=12
MEMORY_RETRIEVAL_MODE=database
MEMORY_RERANK_ENABLED=false
MEMORY_INTERNAL_BASE_URL=http://memory-service:18083
TENANT_INTERNAL_BASE_URL=http://tenant-service:18082
PRIVACY_AUDIT_ENABLED=true
MEMORY_AUDIT_ENABLED=true

# -------------------------
# Billing / Payment / Audit
# -------------------------
AUDIT_INTERNAL_BASE_URL=http://audit-service:18087
PHYOK_AUTH_AUDIT_ENABLED=true
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_PATH=/v2/payments/alipay/notify
ALIPAY_RETURN_PATH=/login
ALIPAY_TIMEOUT_EXPRESS=15m
ALIPAY_DEBUG=false
ALIPAY_CHARSET=UTF-8
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_VERSION=1.0
ALIPAY_PAGE_PAY_METHOD=alipay.trade.page.pay
PAYMENT_SELLER_NAME=PhyOK

# -------------------------
# Ops / Monitoring
# -------------------------
ALERT_EMAIL_TO=ops@example.com
ALERT_EMAIL_FROM=noreply@example.com

OPS_ADMIN_TOTAL_USERS=1280
OPS_ADMIN_PAID_USERS=128
OPS_ADMIN_COMPLAINT_COUNT=3
OPS_ADMIN_AUDIT_EVENT_COUNT=2048
OPS_ADMIN_CPU_LOAD=0.42
OPS_ADMIN_MEMORY_USAGE=61
OPS_ADMIN_DISK_USAGE=58

# -------------------------
# K3s Mirror Overrides
# -------------------------
K3S_REGISTRY_DOCKER_MIRROR_PRIMARY=https://ccr.ccs.tencentyun.com
K3S_REGISTRY_DOCKER_MIRROR_SECONDARY=https://mirror.ccs.tencentyun.com
